[Unit]
Description=Writerdeck - reMarkable Wi-Fi typewriter
Documentation=https://github.com/bjornte/Writerdeck-for-reMarkable
After=network.target

# ExecStart lives on /home -- wait for the partition mount on cold boot.
RequiresMountsFor=/home/root

[Service]
Type=simple

# USB-C back to gadget (rM2; no-op on rM1), re-arm sidebar, then stock UI.
ExecStopPost=/bin/sh -c '/home/root/writerdeck-restore-usb-gadget.sh 2>/dev/null; sleep 1; /home/root/writerdeck-ensure-sidebar.sh 2>/dev/null; systemctl start xochitl'

# Writerdeck-server is always-on: serves :8000 even while xochitl is up.
# --editor: supervisor mode -- owns the xochitl<->Writerdeck toggle.
ExecStart=/home/root/Writerdeck-server --editor /home/root/Writerdeck-launcher.sh

# After server is up, ensure sidebar hook is armed for idle stock UI (rM2).
ExecStartPost=/bin/sh -c '/home/root/writerdeck-ensure-sidebar.sh 2>/dev/null || true'

Restart=no

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
